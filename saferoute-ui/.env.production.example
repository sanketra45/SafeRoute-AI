# Set this in the frontend hosting service before running `npm run build`.
# It must be the public Spring Boot backend origin, without /api or a trailing
# slash. The frontend appends Spring Boot's /api prefix. Do not use localhost.
VITE_API_BASE_URL=https://saferoute-backend-uzx3.onrender.com

# Public Flask ML-service URL. It does not use the /api prefix.
VITE_ML_BASE_URL=https://saferoute-ml-service.onrender.com
