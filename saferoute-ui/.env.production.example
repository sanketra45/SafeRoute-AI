# Set this in the frontend hosting service before running `npm run build`.
# It must be the public Spring Boot API base URL, including /api and without a
# trailing slash. Do not use localhost here.
VITE_API_BASE_URL=https://saferoute-backend-uzx3.onrender.com/api

# Public Flask ML-service URL. It does not use the /api prefix.
VITE_ML_BASE_URL=https://saferoute-ml-service.onrender.com
